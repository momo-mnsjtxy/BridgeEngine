@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(SDL3 CONFIG)
find_dependency(SDL3_image CONFIG)
find_dependency(SDL3_ttf CONFIG)
find_dependency(PkgConfig)
pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET libavcodec libavformat libavutil libswscale libswresample)
find_dependency(FFmpeg)

include("${CMAKE_CURRENT_LIST_DIR}/BridgeEngineTargets.cmake")
