@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(@BRIDGEENGINE_BUILD_STATIC@)
	find_package(SDL3 CONFIG QUIET)
	find_package(SDL3_image CONFIG QUIET)
	find_package(SDL3_ttf CONFIG QUIET)
	if(NOT WIN32)
		find_dependency(PkgConfig)
		macro(bridgeengine_pkg_check_static prefix)
			pkg_check_modules(${prefix} REQUIRED ${ARGN})
			# A target supplied by the consumer is an explicit dependency override.
			if(NOT TARGET PkgConfig::${prefix})
				set(bridgeengine_static_link_options "${${prefix}_STATIC_LDFLAGS_OTHER}")
				set(bridgeengine_static_link_directories "${${prefix}_STATIC_LIBRARY_DIRS}")
				foreach(bridgeengine_link_flag IN LISTS ${prefix}_STATIC_LDFLAGS)
					if(bridgeengine_link_flag MATCHES "^-L(.+)")
						list(APPEND bridgeengine_static_link_directories "${CMAKE_MATCH_1}")
					endif()
				endforeach()
				list(REMOVE_DUPLICATES bridgeengine_static_link_directories)
				if(APPLE)
					set(bridgeengine_static_link_options)
					set(bridgeengine_framework_pending FALSE)
					foreach(bridgeengine_link_option IN LISTS ${prefix}_STATIC_LDFLAGS_OTHER)
						if(bridgeengine_framework_pending)
							list(APPEND bridgeengine_static_link_options
								"SHELL:-framework ${bridgeengine_link_option}")
							set(bridgeengine_framework_pending FALSE)
						elseif(bridgeengine_link_option STREQUAL "-framework")
							set(bridgeengine_framework_pending TRUE)
						else()
							list(APPEND bridgeengine_static_link_options "${bridgeengine_link_option}")
						endif()
					endforeach()
					if(bridgeengine_framework_pending)
						list(APPEND bridgeengine_static_link_options -framework)
					endif()
				endif()
				add_library(PkgConfig::${prefix} INTERFACE IMPORTED)
				set_target_properties(PkgConfig::${prefix} PROPERTIES
					INTERFACE_INCLUDE_DIRECTORIES "${${prefix}_STATIC_INCLUDE_DIRS}"
					INTERFACE_COMPILE_OPTIONS "${${prefix}_STATIC_CFLAGS_OTHER}"
					INTERFACE_LINK_DIRECTORIES "${bridgeengine_static_link_directories}"
					INTERFACE_LINK_LIBRARIES "${${prefix}_STATIC_LIBRARIES}"
					INTERFACE_LINK_OPTIONS "${bridgeengine_static_link_options}"
				)
			endif()
		endmacro()
	endif()

	set(BRIDGEENGINE_SDL3_DEPENDENCY SDL3::SDL3)
	set(BRIDGEENGINE_SDL3_IMAGE_DEPENDENCY SDL3_image::SDL3_image)
	set(BRIDGEENGINE_SDL3_TTF_DEPENDENCY SDL3_ttf::SDL3_ttf)
	if(NOT TARGET SDL3::SDL3 OR NOT TARGET SDL3_image::SDL3_image OR NOT TARGET SDL3_ttf::SDL3_ttf)
		if(WIN32)
			find_dependency(PkgConfig)
		endif()
		if(NOT TARGET SDL3::SDL3)
			if(WIN32)
				pkg_check_modules(SDL3 REQUIRED IMPORTED_TARGET sdl3)
			else()
				bridgeengine_pkg_check_static(SDL3 sdl3)
			endif()
			set(BRIDGEENGINE_SDL3_DEPENDENCY PkgConfig::SDL3)
		endif()
		if(NOT TARGET SDL3_image::SDL3_image)
			if(WIN32)
				pkg_check_modules(SDL3_IMAGE REQUIRED IMPORTED_TARGET sdl3-image)
			else()
				bridgeengine_pkg_check_static(SDL3_IMAGE sdl3-image)
			endif()
			set(BRIDGEENGINE_SDL3_IMAGE_DEPENDENCY PkgConfig::SDL3_IMAGE)
		endif()
		if(NOT TARGET SDL3_ttf::SDL3_ttf)
			if(WIN32)
				pkg_check_modules(SDL3_TTF REQUIRED IMPORTED_TARGET sdl3-ttf)
			else()
				bridgeengine_pkg_check_static(SDL3_TTF sdl3-ttf)
			endif()
			set(BRIDGEENGINE_SDL3_TTF_DEPENDENCY PkgConfig::SDL3_TTF)
		endif()
	endif()

	if(NOT TARGET BridgeEngine::SDL3)
		add_library(BridgeEngine::SDL3 INTERFACE IMPORTED)
		set_target_properties(BridgeEngine::SDL3 PROPERTIES
			INTERFACE_LINK_LIBRARIES "${BRIDGEENGINE_SDL3_DEPENDENCY}"
		)
	endif()
	if(NOT TARGET BridgeEngine::SDL3_image)
		add_library(BridgeEngine::SDL3_image INTERFACE IMPORTED)
		set_target_properties(BridgeEngine::SDL3_image PROPERTIES
			INTERFACE_LINK_LIBRARIES "${BRIDGEENGINE_SDL3_IMAGE_DEPENDENCY}"
		)
	endif()
	if(NOT TARGET BridgeEngine::SDL3_ttf)
		add_library(BridgeEngine::SDL3_ttf INTERFACE IMPORTED)
		set_target_properties(BridgeEngine::SDL3_ttf PROPERTIES
			INTERFACE_LINK_LIBRARIES "${BRIDGEENGINE_SDL3_TTF_DEPENDENCY}"
		)
	endif()

	if(WIN32)
		find_dependency(FFmpeg)
	else()
		bridgeengine_pkg_check_static(FFMPEG
			libavcodec libavformat libavutil libswscale libswresample)
	endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/BridgeEngineTargets.cmake")
