{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 20 },
    "configurePresets": [
        {
            "name":          "default",
            "displayName":   "SDL3 (vcpkg or system)",
            "description":   "PC build targeting SDL3 + FFmpeg. Use -DCMAKE_TOOLCHAIN_FILE for vcpkg.",
            "generator":     "Ninja",
            "binaryDir":     "${sourceDir}/build/default",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "BUILD_EXAMPLES":   "ON"
            }
        },
        {
            "name":          "release",
            "displayName":   "Release build",
            "description":   "Optimised release build with no examples",
            "generator":     "Ninja",
            "binaryDir":     "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_EXAMPLES":   "OFF"
            }
        },
        {
            "name":          "static",
            "displayName":   "Static library build",
            "description":   "Build BridgeEngine as a static library",
            "generator":     "Ninja",
            "binaryDir":     "${sourceDir}/build/static",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "BUILD_EXAMPLES":   "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name":          "default",
            "configurePreset": "default"
        },
        {
            "name":          "release",
            "configurePreset": "release"
        },
        {
            "name":          "static",
            "configurePreset": "static"
        }
    ]
}
